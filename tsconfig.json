{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["ES2025", "DOM"],
    "types": ["vite/client", "@webgpu/types"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
  },
  "include": ["src"]
}
